# Copy this file to `.env.local` and fill in your values.

# ---- Supabase Configuration (Optional) ----
# If omitted or unavailable, the application gracefully operates using an in-memory database with realistic seed data.
# Both Supabase keys are safe to expose to the browser (public keys only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Gemini AI Configuration (Optional) ----
# Used server-side for automated challenge categorization, priority scoring, duplicate detection, and discipline mapping.
# If omitted, the platform automatically falls back to deterministic rule-based keyword classification and priority engines.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
